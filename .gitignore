# Ignore node_modules in both frontend and backend
node_modules/
frontend/node_modules/
backend/node_modules/

# Ignore build files
dist/
build/

# Ignore env and log files
.env
**/.env
**/.env.local
*.log
!**/.env.example
!**/.env.production.example

# Keys / secrets
*.pem
serverpem.pem

# Runtime uploads (keep folder if needed locally)
backend/uploads/*
!backend/uploads/.gitkeep

# Ignore system files
.DS_Store
Thumbs.db
